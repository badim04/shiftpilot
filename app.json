{
  "expo": {
    "name": "ShiftPilot",
    "slug": "shiftpilot",
    "version": "0.1.0",
    "scheme": "shiftpilot",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#10141D",
    "splash": {
      "backgroundColor": "#10141D",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.badim.shiftpilot",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShiftPilot uses your location to calculate live travel time to your next shift.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow background location so ShiftPilot can remind you to check in when you arrive at a venue."
      }
    },
    "android": {
      "package": "com.badim.shiftpilot",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-location",
      "expo-font",
      "expo-asset"
    ]
  }
}
