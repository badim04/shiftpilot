# Copy to .env — Expo exposes EXPO_PUBLIC_* to the client bundle
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — set these as Supabase Edge Function secrets, never in the app:
#   supabase secrets set GOOGLE_MAPS_API_KEY=... ANTHROPIC_API_KEY=...
